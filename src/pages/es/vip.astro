---
import BaseLayout from "@/layouts/BaseLayout.astro";
import business from "@/data/business";
import site from "@/config/site";

const lang = "es";
const canonicalUrl = `${site.url}/es/vip/`;
const alternateUrl = `${site.url}/en/vip/`;
---

<BaseLayout
  title={`Membresía VIP Roadside | ${business.name}`}
  description="Asistencia en carretera prioritaria 24/7 y tarifas blindadas para camioneros y flotas en Dallas-Fort Worth."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
>
  <main class="min-h-screen bg-slate-900 text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto text-center mb-12">
      <span class="inline-block px-4 py-1 rounded-full text-xs font-bold tracking-widest bg-blue-600 text-white uppercase mb-4">
        Cobertura Dallas-Fort Worth 24/7
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        Membresía VIP de Asistencia en Carretera
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto">
        Protección garantizada contra paradas no programadas en todo el corredor DFW. Despacho preferencial en menos de 45 minutos y costos congelados.
      </p>
    </div>

    <!-- Planes de Membresía -->
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
      
      <!-- Plan 1: Operador Independiente -->
      <div class="bg-slate-800 border border-slate-700 rounded-2xl p-8 flex flex-col justify-between shadow-xl">
        <div>
          <h2 class="text-2xl font-bold text-white mb-2">Operador Independiente</h2>
          <p class="text-slate-400 text-sm mb-6">Diseñado para transportistas con 1 camión comercial.</p>
          <div class="flex items-baseline mb-6">
            <span class="text-5xl font-extrabold text-white">$49</span>
            <span class="text-slate-400 ml-2">/ mes</span>
          </div>

          <ul class="space-y-4 text-slate-300 text-sm mb-8">
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>Despacho prioritario &lt; 45 min</strong> en Dallas-Fort Worth.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>2 asistencias menores incluidas al año</strong> (paso de corriente 24V, combustible de emergencia o recarga de aire).</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>15% de descuento</strong> en mano de obra de mecánica móvil.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span>Radio de cobertura de 45 millas (I-35, I-20, I-30, I-635, US-75).</span>
            </li>
          </ul>
        </div>

        <a
          href={`tel:${business.phone}`}
          class="w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 px-6 rounded-xl transition duration-200 shadow-md block text-base"
        >
          Activar Plan Individual al {business.phoneDisplay}
        </a>
      </div>

      <!-- Plan 2: Flota Pequeña -->
      <div class="bg-slate-800 border-2 border-blue-500 rounded-2xl p-8 flex flex-col justify-between shadow-2xl relative">
        <div class="absolute -top-3.5 right-6 bg-blue-500 text-white text-xs font-bold py-1 px-3 rounded-full uppercase tracking-wider">
          Flotas
        </div>

        <div>
          <h2 class="text-2xl font-bold text-white mb-2">Pequeña Flota</h2>
          <p class="text-slate-400 text-sm mb-6">Para empresas y operadores de 2 a 5 camiones.</p>
          <div class="flex items-baseline mb-6">
            <span class="text-5xl font-extrabold text-white">$129</span>
            <span class="text-slate-400 ml-2">/ mes</span>
          </div>

          <ul class="space-y-4 text-slate-300 text-sm mb-8">
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>Línea exclusiva directa 24/7</strong> para despachos de la flota.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>4 asistencias menores incluidas al año</strong> por cuenta.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>1 diagnóstico computarizado móvil sin costo</strong> al año.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>20% de descuento</strong> en servicio de grúa pesada.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span>Cobertura prioritaria en patios logísticos de DFW, Arlington y Alliance.</span>
            </li>
          </ul>
        </div>

        <a
          href={`tel:${business.phone}`}
          class="w-full text-center bg-blue-500 hover:bg-blue-600 text-white font-bold py-3.5 px-6 rounded-xl transition duration-200 shadow-md block text-base"
        >
          Activar Plan Flota al {business.phoneDisplay}
        </a>
      </div>

    </div>

    <!-- Términos y contacto -->
    <div class="max-w-3xl mx-auto text-center mt-12 text-slate-400 text-sm">
      <p>Sin contratos de permanencia forzosa. Activación telefónica inmediata.</p>
      <p class="mt-2">
        ¿Tienes más de 5 unidades? Llámanos para un paquete personalizado al 
        <a href={`tel:${business.phone}`} class="text-blue-400 font-semibold underline">{business.phoneDisplay}</a>.
      </p>
    </div>
  </main>
</BaseLayout>
