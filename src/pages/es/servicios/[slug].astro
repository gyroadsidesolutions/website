---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import FAQ from "@/components/FAQ.astro";
import { activeServices } from "@/data/services";
import { confirmedAreas } from "@/data/serviceAreas";
import business from "@/data/business";
import site from "@/config/site";

export async function getStaticPaths() {
  return activeServices.map((service) => ({
    params: { slug: service.slugEs },
    props: { service },
  }));
}

const { service } = Astro.props;
const lang = "es";
const canonicalUrl = `${site.url}/es/servicios/${service.slugEs}/`;
const alternateUrl = `${site.url}/en/services/${service.slug}/`;

// 1. Consultar fotos actualizadas de Sanity
let sanityImages: Record<string, string> | null = null;
try {
  const query = encodeURIComponent(`*[_type == "serviceImages"] | order(_updatedAt desc)[0]{
    "tireChange": tireChange.asset->url,
    "reeferMaintenance": reeferMaintenance.asset->url,
    "fuelDelivery": fuelDelivery.asset->url,
    "jumpStart": jumpStart.asset->url,
    "oilChange": oilChange.asset->url,
    "brakeService": brakeService.asset->url
  }`);
  const res = await fetch(`https://02066cqd.api.sanity.io/v2021-03-25/data/query/production?query=${query}`);
  if (res.ok) {
    const data = await res.json();
    sanityImages = data.result;
  }
} catch (e) {
  console.error("Error al obtener imágenes de Sanity:", e);
}

// 2. Resolver la foto real del servicio (con respaldo a la imagen local)
function getServiceImage(s: any): string {
  const key = `${s.slug || ''} ${s.slugEs || ''} ${s.image || ''}`.toLowerCase();
  if (key.includes('tire') || key.includes('neumatic')) return sanityImages?.tireChange || s.imageWide || s.image;
  if (key.includes('reefer') || key.includes('refriger')) return sanityImages?.reeferMaintenance || s.imageWide || s.image;
  if (key.includes('fuel') || key.includes('combustible')) return sanityImages?.fuelDelivery || s.imageWide || s.image;
  if (key.includes('jump') || key.includes('bater') || key.includes('corriente')) return sanityImages?.jumpStart || s.imageWide || s.image;
  if (key.includes('oil') || key.includes('aceite')) return sanityImages?.oilChange || s.imageWide || s.image;
  if (key.includes('brake') || key.includes('freno')) return sanityImages?.brakeService || s.imageWide || s.image;
  return s.imageWide || s.image;
}

const heroImage = getServiceImage(service);

const related = activeServices
  .filter((s) => service.relatedSlugs.includes(s.slug) && s.slug !== service.slug)
  .slice(0, 3)
  .map((s) => ({
    ...s,
    image: getServiceImage(s),
  }));

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title.es,
  description: service.shortDescription.es,
  provider: {
    "@type": "LocalBusiness",
    name: business.name,
    telephone: business.phone,
  },
  areaServed: confirmedAreas.map((area) => ({ "@type": "City", name: `${area.city}, ${area.stateCode}` })),
};
---

<BaseLayout
  title={`${service.title.es} — ${business.name}`}
  description={`${service.shortDescription.es} Contáctenos al (214) 302-7757 para coordinar el servicio móvil en el área de Dallas-Fort Worth, Texas.`}
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
  structuredData={serviceSchema}
>
  <Breadcrumbs
    lang={lang}
    items={[
      { label: "Servicios", href: "/es/servicios/" },
      { label: service.title.es },
    ]}
  />

  <section class="bg-primary py-14 md:py-20 relative overflow-hidden" aria-labelledby="service-heading">
    <div class="absolute inset-0 opacity-10" aria-hidden="true">
      <svg class="w-full h-full"><defs><pattern id="sg" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse"><path d="M60 0L0 0 0 60" fill="none" stroke="white" stroke-width="1"/></pattern></defs><rect width="100%" height="100%" fill="url(#sg)"/></svg>
    </div>
    <div class="container relative z-10 flex flex-col md:flex-row items-center gap-10">
      <div class="flex-1">
        <p class="text-secondary font-bold text-sm uppercase tracking-widest mb-3">{business.name}</p>
        <h1 id="service-heading" class="text-white text-4xl md:text-5xl font-extrabold leading-tight mb-4">
          {service.title.es}
        </h1>
        <p class="text-white/80 text-lg mb-8 max-w-lg">{service.shortDescription.es}</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={`tel:${business.phone}`} class="btn bg-secondary text-white hover:bg-secondary-dark text-lg py-4 px-8 font-bold">
            <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Llamar — {business.phoneDisplay}
          </a>
          <a href="/es/contacto/" class="btn bg-white/10 border-2 border-white/30 text-white hover:bg-white hover:text-primary text-lg py-4 px-8">
            Solicitar Servicio
          </a>
        </div>
      </div>
      <div class="flex-shrink-0 w-full md:w-80 lg:w-96">
        <img
          src={heroImage}
          alt={service.imageAlt.es}
          width="1200"
          height="675"
          class="rounded-2xl w-full object-cover shadow-xl aspect-video md:aspect-auto"
          fetchpriority="high"
          onerror="this.onerror=null;this.src='/images/services/placeholder.webp'"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="service-desc-heading">
    <div class="container max-w-3xl">
      <h2 id="service-desc-heading" class="text-primary mb-6">Sobre Este Servicio</h2>
      <div class="prose text-dark text-lg leading-relaxed">
        <p>{service.description.es}</p>
      </div>
      <div class="mt-10 p-6 bg-primary/5 border border-primary/20 rounded-2xl flex flex-col sm:flex-row items-center gap-4">
        <div class="flex-1">
          <p class="font-bold text-dark">¿Necesita este servicio?</p>
          <p class="text-muted text-sm">Contáctenos para coordinar el servicio móvil en el área de Dallas-Fort Worth.</p>
        </div>
        <a href={`tel:${business.phone}`} class="btn-primary flex-shrink-0">{business.phoneDisplay}</a>
      </div>
    </div>
  </section>

  {service.faq.length > 0 && <FAQ lang={lang} items={service.faq} />}

  {related.length > 0 && (
    <section class="section bg-light" aria-labelledby="related-heading">
      <div class="container">
        <h2 id="related-heading" class="text-primary text-center mb-10">Servicios Relacionados</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {related.map((s) => <ServiceCard service={s} lang={lang} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
