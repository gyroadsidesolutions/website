---
import BaseLayout from "@/layouts/BaseLayout.astro";
import business from "@/data/business";
import site from "@/config/site";

const lang = "en";
const canonicalUrl = `${site.url}/en/vip/`;
const alternateUrl = `${site.url}/es/vip/`;
---

<BaseLayout
  title={`VIP Roadside Membership Plans | ${business.name}`}
  description="Commercial fleet and owner-operator annual roadside maintenance plans in Dallas-Fort Worth. 24/7 priority dispatch and pre-negotiated labor rates."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
>
  <main class="min-h-screen bg-slate-900 text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto text-center mb-14">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold tracking-widest bg-amber-500/10 text-amber-400 border border-amber-500/30 uppercase mb-4">
        Annual Preventive Maintenance & Roadside Agreements
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        Commercial VIP Membership Plans
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-3xl mx-auto">
        Downtime protection across Dallas-Fort Worth. 24/7 priority mobile dispatch, scheduled maintenance labor included, and locked-in fleet rates with zero price gouging.
      </p>
    </div>

    <!-- 3 Pricing Cards -->
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch mb-16">
      
      <!-- Plan 1: GY Basic -->
      <div class="bg-slate-800/90 border border-slate-700 rounded-2xl p-7 flex flex-col justify-between shadow-xl">
        <div>
          <span class="text-xs font-bold tracking-wider text-slate-400 uppercase">Solo Driver</span>
          <h2 class="text-2xl font-bold text-white mt-1 mb-2">GY Basic</h2>
          <p class="text-slate-400 text-xs mb-6">Essential routine maintenance for 1 commercial truck.</p>
          
          <div class="flex items-baseline mb-6">
            <span class="text-4xl sm:text-5xl font-black text-white">$99</span>
            <span class="text-slate-400 text-sm ml-2 font-medium">/ month</span>
          </div>
          <p class="text-[11px] text-amber-400/90 font-medium -mt-4 mb-6">*Mandatory 12-month annual service contract</p>

          <div class="border-t border-slate-700/80 pt-4 mb-6">
            <p class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Included Annual Labor:</p>
            <ul class="space-y-3 text-slate-300 text-xs">
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>2 engine oil & filter service labor calls</strong> (min. 3-month interval).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>Brake service labor</strong> on up to 2 wheel ends (1 axle).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>Tire mounting/dismounting labor</strong> for up to 2 commercial tires.</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>1 basic reefer exterior wash & sanitization</strong> (*wash-out*).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>10% off reefer PM labor</strong> (available after 5 months).</span>
              </li>
            </ul>
          </div>

          <div class="border-t border-slate-700/80 pt-4 mb-6">
            <p class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Additional Discounts:</p>
            <ul class="space-y-2 text-slate-400 text-xs">
              <li>• 10% discount on parts and lubricants supplied by GY.</li>
              <li>• 10% discount on mobile dispatch mileage charges.</li>
              <li>• 5% labor discount on non-included roadside repairs.</li>
            </ul>
          </div>
        </div>

        <a
          href={`tel:${business.phone}`}
          class="w-full text-center bg-slate-700 hover:bg-slate-600 text-white font-bold py-3.5 px-4 rounded-xl transition duration-200 shadow-md block text-sm"
        >
          Enroll GY Basic: {business.phoneDisplay}
        </a>
      </div>

      <!-- Plan 2: GY Plus -->
      <div class="bg-slate-800 border-2 border-blue-500 rounded-2xl p-7 flex flex-col justify-between shadow-2xl relative">
        <div class="absolute -top-3.5 right-6 bg-blue-600 text-white text-[11px] font-bold py-1 px-3 rounded-full uppercase tracking-wider shadow">
          Most Popular
        </div>

        <div>
          <span class="text-xs font-bold tracking-wider text-blue-400 uppercase">Refrigerated Hauling</span>
          <h2 class="text-2xl font-bold text-white mt-1 mb-2">GY Plus</h2>
          <p class="text-slate-400 text-xs mb-6">Continuous protection for tractor and reefer trailer.</p>
          
          <div class="flex items-baseline mb-6">
            <span class="text-4xl sm:text-5xl font-black text-white">$169</span>
            <span class="text-slate-400 text-sm ml-2 font-medium">/ month</span>
          </div>
          <p class="text-[11px] text-amber-400/90 font-medium -mt-4 mb-6">*Mandatory 12-month annual service contract</p>

          <div class="border-t border-slate-700/80 pt-4 mb-6">
            <p class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Included Annual Labor:</p>
            <ul class="space-y-3 text-slate-300 text-xs">
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>2 engine oil changes</strong> (1st 100% labor covered; 2nd with 20% labor discount).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>Brake service labor</strong> on up to 2 wheel ends (1 axle).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>Tire mounting/dismounting labor</strong> for up to 2 commercial tires.</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>1 basic reefer wash-out</strong> included per year.</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>1 free comprehensive reefer diagnostic inspection</strong>.</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>20% off reefer PM labor</strong> (available after 5 months).</span>
              </li>
            </ul>
          </div>

          <div class="border-t border-slate-700/80 pt-4 mb-6">
            <p class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Additional Discounts:</p>
            <ul class="space-y-2 text-slate-400 text-xs">
              <li>• 15% discount on parts and lubricants supplied by GY.</li>
              <li>• 20% discount on mobile dispatch mileage charges.</li>
              <li>• 10% labor discount on non-included roadside repairs.</li>
            </ul>
          </div>
        </div>

        <a
          href={`tel:${business.phone}`}
          class="w-full text-center bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 px-4 rounded-xl transition duration-200 shadow-md block text-sm"
        >
          Enroll GY Plus: {business.phoneDisplay}
        </a>
      </div>

      <!-- Plan 3: GY Premium -->
      <div class="bg-slate-800/90 border border-amber-500/40 rounded-2xl p-7 flex flex-col justify-between shadow-xl">
        <div>
          <span class="text-xs font-bold tracking-wider text-amber-400 uppercase">Fleets & Critical Loads</span>
          <h2 class="text-2xl font-bold text-white mt-1 mb-2">GY Premium</h2>
          <p class="text-slate-400 text-xs mb-6">Top-tier prioritized coverage for demanding schedules.</p>
          
          <div class="flex items-baseline mb-6">
            <span class="text-4xl sm:text-5xl font-black text-white">$199</span>
            <span class="text-slate-400 text-sm ml-2 font-medium">/ month</span>
          </div>
          <p class="text-[11px] text-amber-400/90 font-medium -mt-4 mb-6">*Mandatory 12-month annual service contract</p>

          <div class="border-t border-slate-700/80 pt-4 mb-6">
            <p class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Included Annual Labor:</p>
            <ul class="space-y-3 text-slate-300 text-xs">
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>2 engine oil changes</strong> (1st 100% labor covered; 2nd with 30% labor discount).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>Brake service labor</strong> on up to 2 wheel ends (1 axle).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>Tire mounting/dismounting labor</strong> for up to 2 commercial tires.</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>2 basic reefer wash-outs</strong> included per year.</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>2 free comprehensive reefer diagnostic inspections</strong>.</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>25% off reefer PM labor</strong> (available after 5 months).</span>
              </li>
            </ul>
          </div>

          <div class="border-t border-slate-700/80 pt-4 mb-6">
            <p class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Additional Discounts:</p>
            <ul class="space-y-2 text-slate-400 text-xs">
              <li>• 20% discount on parts and lubricants supplied by GY.</li>
              <li>• 25% discount on mobile dispatch mileage charges.</li>
              <li>• 15% labor discount on non-included roadside repairs.</li>
            </ul>
          </div>
        </div>

        <a
          href={`tel:${business.phone}`}
          class="w-full text-center bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-3.5 px-4 rounded-xl transition duration-200 shadow-md block text-sm"
        >
          Enroll GY Premium: {business.phoneDisplay}
        </a>
      </div>

    </div>

    <!-- Legal Terms and Disclaimers -->
    <div class="max-w-5xl mx-auto bg-slate-950/80 border border-slate-800 rounded-2xl p-6 sm:p-8 text-slate-400 text-xs leading-relaxed">
      <h3 class="text-white text-sm font-bold uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
        Operating Terms & General Conditions of Membership
      </h3>
      <div class="space-y-3">
        <p>
          <strong class="text-slate-200">1. Labor-Only Scope:</strong> Memberships cover technical labor fees only. Replacement parts, brake shoes, drums, tires, lubricants, engine oils, refrigerants, belts, and shop supplies are billed separately with the applicable tier discount.
        </p>
        <p>
          <strong class="text-slate-200">2. Customer-Supplied Parts Disclaimer:</strong> If the Member elects to provide their own parts, membership discounts apply strictly to labor. GY Roadside Solutions LLC provides no express or implied warranty on third-party components and assumes no liability for premature failure, mechanical damage, or roadside accidents resulting from third-party parts.
        </p>
        <p>
          <strong class="text-slate-200">3. Term Commitment:</strong> All memberships require a 12-month service commitment. Early termination requires settlement of utilized discounts at standard retail rates or remaining term balances as specified in the signed service agreement.
        </p>
        <p>
          <strong class="text-slate-200">4. Reefer PM & EPA Compliance:</strong> Preventive maintenance labor strictly includes reefer engine oil/filter replacement, belt changes, and operational pressure checks. Pursuant to Section 608 of the Clean Air Act (EPA), refrigerant will not be added to systems with unaddressed leaks.
        </p>
        <p>
          <strong class="text-slate-200">5. Limitation of Liability:</strong> Under no circumstances shall GY Roadside Solutions LLC be held liable for lost freight profits, perishable cargo spoilage, DOT delays, or consequential damages resulting from road conditions or mechanical failures.
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
