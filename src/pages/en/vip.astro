---
import BaseLayout from "@/layouts/BaseLayout.astro";
import business from "@/data/business";
import site from "@/config/site";

const lang = "en";
const canonicalUrl = `${site.url}/en/vip/`;
const alternateUrl = `${site.url}/es/vip/`;
---

<BaseLayout
  title={`VIP Roadside Membership | ${business.name}`}
  description="Priority 24/7 commercial roadside assistance and locked-in rates for owner-operators and fleets in Dallas-Fort Worth."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
>
  <main class="min-h-screen bg-slate-900 text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto text-center mb-12">
      <span class="inline-block px-4 py-1 rounded-full text-xs font-bold tracking-widest bg-blue-600 text-white uppercase mb-4">
        24/7 Dallas-Fort Worth Coverage
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        VIP Roadside Assistance Membership
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto">
        Guaranteed downtime protection along the entire DFW freight corridor. Priority dispatch under 45 minutes and pre-negotiated repair rates.
      </p>
    </div>

    <!-- Pricing Grid -->
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
      
      <!-- Plan 1: Owner-Operator -->
      <div class="bg-slate-800 border border-slate-700 rounded-2xl p-8 flex flex-col justify-between shadow-xl">
        <div>
          <h2 class="text-2xl font-bold text-white mb-2">Owner-Operator</h2>
          <p class="text-slate-400 text-sm mb-6">Designed for solo drivers with 1 commercial truck.</p>
          <div class="flex items-baseline mb-6">
            <span class="text-5xl font-extrabold text-white">$49</span>
            <span class="text-slate-400 ml-2">/ month</span>
          </div>

          <ul class="space-y-4 text-slate-300 text-sm mb-8">
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>Priority dispatch &lt; 45 min</strong> across Dallas-Fort Worth.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>2 minor roadside calls included per year</strong> (24V jump start, emergency fuel delivery, or tire air refill).</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>15% labor discount</strong> on mobile mechanical diagnostics and repairs.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span>45-mile coverage radius (I-35, I-20, I-30, I-635, US-75).</span>
            </li>
          </ul>
        </div>

        <a
          href={`tel:${business.phone}`}
          class="w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 px-6 rounded-xl transition duration-200 shadow-md block text-base"
        >
          Enroll Solo Plan: {business.phoneDisplay}
        </a>
      </div>

      <!-- Plan 2: Small Fleet -->
      <div class="bg-slate-800 border-2 border-blue-500 rounded-2xl p-8 flex flex-col justify-between shadow-2xl relative">
        <div class="absolute -top-3.5 right-6 bg-blue-500 text-white text-xs font-bold py-1 px-3 rounded-full uppercase tracking-wider">
          Fleets
        </div>

        <div>
          <h2 class="text-2xl font-bold text-white mb-2">Small Fleet</h2>
          <p class="text-slate-400 text-sm mb-6">For carriers and companies operating 2 to 5 trucks.</p>
          <div class="flex items-baseline mb-6">
            <span class="text-5xl font-extrabold text-white">$129</span>
            <span class="text-slate-400 ml-2">/ month</span>
          </div>

          <ul class="space-y-4 text-slate-300 text-sm mb-8">
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>Dedicated 24/7 VIP hotline</strong> for fleet dispatch.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>4 minor roadside calls included per year</strong> per fleet.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>1 free mobile computer diagnostic scan</strong> per year.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span><strong>20% discount</strong> on heavy-duty towing services.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 font-bold mr-3">✓</span>
              <span>Full coverage across DFW logistics hubs, Arlington, and Alliance yards.</span>
            </li>
          </ul>
        </div>

        <a
          href={`tel:${business.phone}`}
          class="w-full text-center bg-blue-500 hover:bg-blue-600 text-white font-bold py-3.5 px-6 rounded-xl transition duration-200 shadow-md block text-base"
        >
          Enroll Fleet Plan: {business.phoneDisplay}
        </a>
      </div>

    </div>

    <!-- Support Notice -->
    <div class="max-w-3xl mx-auto text-center mt-12 text-slate-400 text-sm">
      <p>No long-term commitments. Instant phone enrollment on your first call.</p>
      <p class="mt-2">
        Managing more than 5 commercial units? Call for custom enterprise rates at 
        <a href={`tel:${business.phone}`} class="text-blue-400 font-semibold underline">{business.phoneDisplay}</a>.
      </p>
    </div>
  </main>
</BaseLayout>
