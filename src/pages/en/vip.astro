---
import BaseLayout from "@/layouts/BaseLayout.astro";
import business from "@/data/business";
import site from "@/config/site";

const lang = "en";
const canonicalUrl = `${site.url}/en/vip/`;
const alternateUrl = `${site.url}/es/vip/`;
---

<BaseLayout
  title={`Commercial VIP Membership Plans | ${business.name}`}
  description="Annual roadside maintenance and 24/7 mobile assistance across Dallas-Fort Worth for 3-axle commercial trucks and reefer units with locked-in fleet rates."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
>
  <main class="min-h-screen bg-slate-900 text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto text-center mb-14">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold tracking-widest bg-amber-500/10 text-amber-400 border border-amber-500/30 uppercase mb-4">
        Annual Maintenance & Roadside Service Agreements
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        Commercial VIP Membership Plans
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-3xl mx-auto">
        Downtime protection across Dallas-Fort Worth. Scheduled labor coverage across all 3 truck axles, reefer unit maintenance, and 24/7 priority mobile dispatch.
      </p>
    </div>

    <!-- Pricing Grid -->
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch mb-16">
      
      <!-- Plan 1: GY Basic -->
      <div class="bg-slate-800/90 border border-slate-700 rounded-2xl p-7 flex flex-col justify-between shadow-xl">
        <div>
          <span class="text-xs font-bold tracking-wider text-slate-400 uppercase">Solo Driver</span>
          <h2 class="text-2xl font-bold text-white mt-1 mb-2">GY Basic</h2>
          <p class="text-slate-400 text-xs mb-6">Essential routine maintenance for 1 commercial 3-axle truck.</p>
          
          <div class="flex items-baseline mb-6">
            <span class="text-4xl sm:text-5xl font-black text-white">$99</span>
            <span class="text-slate-400 text-sm ml-2 font-medium">/ month</span>
          </div>
          <p class="text-[11px] text-amber-400/90 font-medium -mt-4 mb-6">*Mandatory 12-month annual service contract</p>

          <div class="border-t border-slate-700/80 pt-4 mb-6">
            <p class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Included Annual Labor:</p>
            <ul class="space-y-3 text-slate-300 text-xs">
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>2 engine oil & filter services</strong> (labor only; min. 3-month interval).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>Brake replacement labor across all 3 truck axles</strong> (1 service/year when parts are supplied by GY).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>Tire replacement labor across all 3 truck axles</strong> (1 service/year when tires are supplied by GY).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>1 technical reefer unit cleaning</strong> (condenser coil blow-out & motor bay degrease; trailer wash-out not included).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>10% off reefer PM labor</strong> (available after 5 active months).</span>
              </li>
            </ul>
          </div>

          <div class="border-t border-slate-700/80 pt-4 mb-6">
            <p class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Commercial Discounts:</p>
            <ul class="space-y-2 text-slate-400 text-xs">
              <li>• 10% discount on total cost of parts and lubricants.</li>
              <li>• 10% discount on mobile dispatch mileage charges.</li>
              <li>• 5% labor discount on non-included roadside services.</li>
            </ul>
          </div>
        </div>

        <a
          href={`tel:${business.phone}`}
          class="w-full text-center bg-slate-700 hover:bg-slate-600 text-white font-bold py-3.5 px-4 rounded-xl transition duration-200 shadow-md block text-sm"
        >
          Enroll GY Basic: {business.phoneDisplay}
        </a>
      </div>

      <!-- Plan 2: GY Plus -->
      <div class="bg-slate-800 border-2 border-blue-500 rounded-2xl p-7 flex flex-col justify-between shadow-2xl relative">
        <div class="absolute -top-3.5 right-6 bg-blue-600 text-white text-[11px] font-bold py-1 px-3 rounded-full uppercase tracking-wider shadow">
          Most Popular
        </div>

        <div>
          <span class="text-xs font-bold tracking-wider text-blue-400 uppercase">Refrigerated Hauling</span>
          <h2 class="text-2xl font-bold text-white mt-1 mb-2">GY Plus</h2>
          <p class="text-slate-400 text-xs mb-6">Continuous protection for 3-axle tractor and cooling unit.</p>
          
          <div class="flex items-baseline mb-6">
            <span class="text-4xl sm:text-5xl font-black text-white">$169</span>
            <span class="text-slate-400 text-sm ml-2 font-medium">/ month</span>
          </div>
          <p class="text-[11px] text-amber-400/90 font-medium -mt-4 mb-6">*Mandatory 12-month annual service contract</p>

          <div class="border-t border-slate-700/80 pt-4 mb-6">
            <p class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Included Annual Labor:</p>
            <ul class="space-y-3 text-slate-300 text-xs">
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>2 engine oil changes</strong> (1st labor covered; 2nd with 20% labor discount; min. 3-month interval).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>Brake replacement labor across all 3 truck axles</strong> (1 service/year when parts are supplied by GY).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>Tire replacement labor across all 3 truck axles</strong> (1 service/year when tires are supplied by GY).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>1 technical reefer unit cleaning</strong> (condenser coil blow-out & motor degrease).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>1 free operational inspection & pressure check</strong> on reefer unit.</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>20% off reefer PM labor</strong> (available after 5 active months).</span>
              </li>
            </ul>
          </div>

          <div class="border-t border-slate-700/80 pt-4 mb-6">
            <p class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Commercial Discounts:</p>
            <ul class="space-y-2 text-slate-400 text-xs">
              <li>• 15% discount on total cost of parts and lubricants.</li>
              <li>• 20% discount on mobile dispatch mileage charges.</li>
              <li>• 10% labor discount on non-included roadside services.</li>
            </ul>
          </div>
        </div>

        <a
          href={`tel:${business.phone}`}
          class="w-full text-center bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 px-4 rounded-xl transition duration-200 shadow-md block text-sm"
        >
          Enroll GY Plus: {business.phoneDisplay}
        </a>
      </div>

      <!-- Plan 3: GY Premium -->
      <div class="bg-slate-800/90 border border-amber-500/40 rounded-2xl p-7 flex flex-col justify-between shadow-xl">
        <div>
          <span class="text-xs font-bold tracking-wider text-amber-400 uppercase">Fleets & Critical Loads</span>
          <h2 class="text-2xl font-bold text-white mt-1 mb-2">GY Premium</h2>
          <p class="text-slate-400 text-xs mb-6">Maximum priority and mechanical backing in DFW.</p>
          
          <div class="flex items-baseline mb-6">
            <span class="text-4xl sm:text-5xl font-black text-white">$199</span>
            <span class="text-slate-400 text-sm ml-2 font-medium">/ month</span>
          </div>
          <p class="text-[11px] text-amber-400/90 font-medium -mt-4 mb-6">*Mandatory 12-month annual service contract</p>

          <div class="border-t border-slate-700/80 pt-4 mb-6">
            <p class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Included Annual Labor:</p>
            <ul class="space-y-3 text-slate-300 text-xs">
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>2 engine oil changes</strong> (1st labor covered; 2nd with 30% labor discount; min. 3-month interval).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>Brake replacement labor across all 3 truck axles</strong> (1 service/year when parts are supplied by GY).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>Tire replacement labor across all 3 truck axles</strong> (1 service/year when tires are supplied by GY).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>2 technical reefer unit cleanings</strong> (condenser blow-out & motor bay degrease).</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>2 free operational inspections & pressure checks</strong> on reefer unit.</span>
              </li>
              <li class="flex items-start">
                <span class="text-emerald-400 font-bold mr-2">✓</span>
                <span><strong>25% off reefer PM labor</strong> (available after 5 active months).</span>
              </li>
            </ul>
          </div>

          <div class="border-t border-slate-700/80 pt-4 mb-6">
            <p class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Commercial Discounts:</p>
            <ul class="space-y-2 text-slate-400 text-xs">
              <li>• 20% discount on total cost of parts and lubricants.</li>
              <li>• 25% discount on mobile dispatch mileage charges.</li>
              <li>• 15% labor discount on non-included roadside services.</li>
            </ul>
          </div>
        </div>

        <a
          href={`tel:${business.phone}`}
          class="w-full text-center bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-3.5 px-4 rounded-xl transition duration-200 shadow-md block text-sm"
        >
          Enroll GY Premium: {business.phoneDisplay}
        </a>
      </div>

    </div>

    <!-- Operating Terms & Disclaimers -->
    <div class="max-w-5xl mx-auto bg-slate-950/80 border border-slate-800 rounded-2xl p-6 sm:p-8 text-slate-400 text-xs leading-relaxed">
      <h3 class="text-white text-sm font-bold uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
        Membership Operating Terms & Legal Disclaimers
      </h3>
      <div class="space-y-3">
        <p>
          <strong class="text-slate-200">1. Labor vs. Parts Provision:</strong> Memberships cover technical labor fees. The inclusion of brake and tire replacement labor across all three (3) truck axles is strictly contingent upon parts (brake shoes, drums, hardware kits, and tires) being supplied and purchased directly through GY Roadside Solutions LLC at the member discount rate. If the member provides their own parts, tier discounts apply exclusively to standard hourly labor rates.
        </p>
        <p>
          <strong class="text-slate-200">2. Reefer Mechanical Unit Scope:</strong> Inspection, technical cleaning, and preventive maintenance services apply exclusively to the mechanical refrigeration unit (diesel engine, belts, filters, compressor, condenser coils; Carrier / Thermo King models). Under no circumstances do these services include interior or exterior trailer cargo box wash-outs.
        </p>
        <p>
          <strong class="text-slate-200">3. 12-Month Service Agreement:</strong> All membership tiers require an annual commitment of twelve (12) consecutive months. Unused annual service calls are non-transferable and do not roll over.
        </p>
        <p>
          <strong class="text-slate-200">4. Environmental EPA Compliance:</strong> Reefer general maintenance strictly covers oil/filter changes, belt replacements, and pressure diagnostics. Pursuant to Section 608 of the Clean Air Act (EPA), refrigerant will not be added to refrigeration systems with unaddressed leaks.
        </p>
        <p>
          <strong class="text-slate-200">5. Cargo Loss Disclaimer:</strong> GY Roadside Solutions LLC accepts no liability for lost freight revenues, perishable cargo spoilage, load rejections, highway delays, or Department of Transportation (DOT) citations.
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
