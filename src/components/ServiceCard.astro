---
import type { Service } from "@/data/services";
import type { Lang } from "@/i18n/index";
import { t } from "@/i18n/index";

export interface Props {
  service: Service;
  lang: Lang;
  featured?: boolean;
}

const { service, lang, featured = false } = Astro.props;
const tr = t(lang);

// 1. Consultar fotos de Sanity
let sanityImages: Record<string, string> | null = null;
try {
  const query = encodeURIComponent(`*[_type == "serviceImages"] | order(_updatedAt desc)[0]{
    "tireChange": tireChange.asset->url,
    "reeferMaintenance": reeferMaintenance.asset->url,
    "fuelDelivery": fuelDelivery.asset->url,
    "jumpStart": jumpStart.asset->url,
    "oilChange": oilChange.asset->url,
    "brakeService": brakeService.asset->url
  }`);
  const res = await fetch(`https://02066cqd.api.sanity.io/v2021-03-25/data/query/production?query=${query}`);
  if (res.ok) {
    const data = await res.json();
    sanityImages = data.result;
  }
} catch (e) {
  console.error("Error al obtener imágenes de Sanity en ServiceCard:", e);
}

// 2. Vincular imagen de Sanity con respaldo a las fotos locales
function getServiceImage(s: any): string {
  const key = `${s.slug || ''} ${s.slugEs || ''} ${s.image || ''} ${s.imageWide || ''}`.toLowerCase();
  if (key.includes('tire') || key.includes('neumatic')) return sanityImages?.tireChange || s.imageWide || s.image;
  if (key.includes('reefer') || key.includes('refriger')) return sanityImages?.reeferMaintenance || s.imageWide || s.image;
  if (key.includes('fuel') || key.includes('combustible')) return sanityImages?.fuelDelivery || s.imageWide || s.image;
  if (key.includes('jump') || key.includes('bater') || key.includes('corriente')) return sanityImages?.jumpStart || s.imageWide || s.image;
  if (key.includes('oil') || key.includes('aceite')) return sanityImages?.oilChange || s.imageWide || s.image;
  if (key.includes('brake') || key.includes('freno')) return sanityImages?.brakeService || s.imageWide || s.image;
  return s.imageWide || s.image;
}

const cardImage = getServiceImage(service);

const href = lang === "es"
  ? `/es/servicios/${service.slugEs}/`
  : `/en/services/${service.slug}/`;
---

<article
  class="card group flex flex-col h-full ring-2 ring-secondary/20"
  aria-label={service.title[lang]}
>
  <!-- Image -->
  <div class="relative overflow-hidden aspect-[16/9] bg-gray-100">
    <img
      src={cardImage}
      alt={service.imageAlt[lang]}
      width="480"
      height="270"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      onerror="this.onerror=null;this.src='/images/services/placeholder.webp'"
    />
    
<div class="absolute top-3 right-3 text-2xl" aria-hidden="true">
      {service.icon}
    </div>
  </div>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-6">
    <h3 class="text-primary font-bold text-lg mb-2 group-hover:text-primary-light transition-colors">
      {service.title[lang]}
    </h3>
    <p class="text-muted text-sm leading-relaxed flex-1 mb-4">
      {service.shortDescription[lang]}
    </p>
    <a
      href={href}
      class="btn-outline text-sm py-2 px-4 w-full justify-center"
      aria-label={`${tr.services.learnMore}: ${service.title[lang]}`}
    >
      {tr.services.learnMore}
      <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>
