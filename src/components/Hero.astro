---
import business from "@/data/business";
import { t } from "@/i18n/index";
import type { Lang } from "@/i18n/index";
import { sanityClient } from "sanity:client";

export interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);
const servicesPath = lang === "es" ? `/${lang}/servicios/` : `/${lang}/services/`;

// Fotos locales de respaldo mientras tu primo prepara la nueva
const fallbackDesktop = "/images/hero/heroImageFinal.webp";
const fallbackMobile = "/images/hero/heroImageFinal-mobile.webp";

let desktopImage = fallbackDesktop;
let mobileImage = fallbackMobile;

try {
  const sanityHero = await sanityClient.fetch(`*[_type == "heroSettings"][0]{
    "desktop": image.asset->url,
    "mobile": image.asset->url + "?w=640&h=1000&fit=crop&crop=center&auto=format"
  }`);

  if (sanityHero?.desktop) {
    desktopImage = sanityHero.desktop;
    mobileImage = sanityHero.mobile;
  }
} catch (error) {
  console.warn("Usando foto estática de respaldo para el Hero:", error);
}
---

<section
  class="hero relative bg-primary overflow-hidden"
  aria-labelledby="hero-heading"
>
  <!-- Background photo — art-directed per viewport:
       wide 1.5:1 scene on tablet/desktop, portrait crop (mechanic + tire) on phones -->
  <div class="absolute inset-0" aria-hidden="true">
    <picture>
      <source
        media="(max-width: 640px)"
        srcset={mobileImage}
        type="image/webp"
      />
      <img
        src={desktopImage}
        alt=""
        class="hero-img"
        fetchpriority="high"
        decoding="async"
        onerror="this.style.display='none'"
      />
    </picture>
    <!-- Dark overlay — kept only as a left-side gradient for white-text contrast; right side is bright -->
    <div class="absolute inset-0 bg-gradient-to-r from-primary/90 via-primary/65 to-primary/25"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary/45 via-transparent to-transparent"></div>
  </div>

  <!-- Content -->
  <div class="container relative z-10 flex flex-col justify-center py-16 md:py-24 lg:py-32"
       style="min-height: inherit;">
    <div class="max-w-xl lg:max-w-2xl">

      <!-- Category label — yellow small caps -->
      <span class="section-label" aria-hidden="true">
        {lang === "es" ? "Asistencia en Carretera para Camiones" : "Truck Roadside Assistance"}
      </span>

      <!-- Main headline -->
      <h1 id="hero-heading" class="text-white text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.05] mb-4">
        {lang === "es" ? (
          <>
            ¡Te Mantenemos<br />
            <span class="text-accent">en Movimiento!</span>
          </>
        ) : (
          <>
            We Keep You<br />
            <span class="text-accent">Moving!</span>
          </>
        )}
      </h1>

      <!-- Subheadline -->
      <p class="text-white text-lg sm:text-xl font-semibold mb-3">
        {lang === "es"
          ? "Rapidez y compromiso respaldan nuestro trabajo."
          : "Speed and commitment back up everything we do."}
      </p>

      <!-- Description -->
      <p class="text-white/90 text-base leading-relaxed mb-8 max-w-lg">
        {lang === "es"
          ? `GY Roadside Solutions LLC ofrece asistencia móvil para camiones comerciales y otros vehículos en el área de Dallas-Fort Worth, Texas, directamente donde se encuentren ubicados.`
          : `GY Roadside Solutions LLC provides mobile assistance for commercial trucks and other vehicles in the Dallas-Fort Worth, Texas area, right where you are located.`}
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href={`tel:${business.phone}`}
          class="btn bg-accent text-dark hover:bg-accent-light shadow-cta text-base sm:text-lg py-4 px-8 font-bold"
          aria-label={`${tr.hero.ctaCall} — ${business.phoneDisplay}`}
        >
          <svg aria-hidden="true" class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {lang === "es" ? "Llamar Ahora" : "Call Now"}
        </a>
        <a
          href={servicesPath}
          class="btn bg-transparent border-2 border-white text-white hover:bg-white hover:text-dark text-base sm:text-lg py-4 px-8 font-semibold"
        >
          {lang === "es" ? "Nuestros Servicios" : "Our Services"}
          <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .hero {
    min-height: clamp(520px, 82vh, 800px);
  }
  @supports (height: 100svh) {
    .hero { min-height: clamp(560px, 82svh, 800px); }
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: brightness(1.05) saturate(1.05) contrast(1.05);
  }

  @media (max-width: 640px) {
    .hero-img {
      object-position: center center;
      height: 100%;
      width: 100%;
    }
  }
</style>
