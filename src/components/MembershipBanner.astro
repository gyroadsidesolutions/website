---
import type { Lang } from "@/i18n/index";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEs = lang === "es";
const vipUrl = isEs ? "/es/vip/" : "/en/vip/";
---

<section class="py-12 px-4 sm:px-6 lg:px-8 bg-slate-900 border-y border-slate-800">
  <div class="max-w-4xl mx-auto text-center">
    <!-- Badge de estado On Hold -->
    <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold tracking-widest bg-amber-500/20 text-amber-400 border border-amber-500/40 uppercase mb-4">
      {isEs ? "PRÓXIMAMENTE — EN REVISIÓN OPERATIVA" : "COMING SOON — UNDER OPERATIONAL REVIEW"}
    </span>

    <!-- Título -->
    <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
      {isEs 
        ? "Membresía VIP Roadside para Camioneros y Flotas" 
        : "VIP Roadside Membership for Fleets & Owner-Operators"}
    </h2>

    <!-- Descripción -->
    <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto mb-8 leading-relaxed">
      {isEs
        ? "Conoce nuestro próximo programa de mantenimiento preventivo y auxilio vial en Dallas-Fort Worth. Cobertura planificada para tractocamiones y unidades reefer con cupos limitados."
        : "Explore our upcoming roadside and preventive maintenance program across Dallas-Fort Worth. Planned coverage for commercial tractors and reefer units with limited slots."}
    </p>

    <!-- Tarjetas de Beneficios Corregidas (Sin promesas de minutos) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 text-left">
      <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4">
        <p class="text-amber-400 font-bold text-xs sm:text-sm mb-1">
          ✓ {isEs ? "Prioridad de despacho 24/7" : "24/7 Priority Dispatch"}
        </p>
        <p class="text-slate-400 text-xs">
          {isEs ? "Atención preferencial sujeta a disponibilidad y tráfico." : "Preferred queue handling subject to traffic conditions."}
        </p>
      </div>

      <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4">
        <p class="text-amber-400 font-bold text-xs sm:text-sm mb-1">
          ✓ {isEs ? "Cobertura en 3 ejes y reefer" : "3-Axle & Reefer Coverage"}
        </p>
        <p class="text-slate-400 text-xs">
          {isEs ? "Mano de obra anual en frenos, neumáticos, motor y frío." : "Annual labor inclusions for brakes, tires, oil & reefer unit."}
        </p>
      </div>

      <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4">
        <p class="text-amber-400 font-bold text-xs sm:text-sm mb-1">
          ✓ {isEs ? "Tarifas y piezas congeladas" : "Locked-In Commercial Rates"}
        </p>
        <p class="text-slate-400 text-xs">
          {isEs ? "Descuentos contractuales en repuestos y millaje móvil." : "Fixed contract discounts on parts, labor, and dispatch mileage."}
        </p>
      </div>
    </div>

    <!-- Botón hacia /vip/ con aviso de Próximamente -->
    <div class="inline-block">
      <a
        href={vipUrl}
        class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-3.5 px-7 rounded-xl transition duration-200 shadow-lg text-sm sm:text-base"
      >
        <span>{isEs ? "Consultar Estructura de Planes (Próximamente) →" : "Preview Membership Plans (Coming Soon) →"}</span>
      </a>
    </div>
  </div>
</section>
