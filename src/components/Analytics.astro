---
import site from "@/config/site";

const gaId = site.analytics.gaId;
---

{gaId && (
  <>
    <!-- Google tag (gtag.js) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", gaId, {
        send_page_view: true,
      });

      // Interceptor optimizado para móviles y computadoras
      document.addEventListener("click", function (event) {
        var phoneLink = event.target && event.target.closest ? event.target.closest('a[href^="tel:"]') : null;
        if (!phoneLink) return;

        var phoneUrl = phoneLink.getAttribute("href");
        if (!phoneUrl) return;

        // 1. Evita que el celular congele el navegador antes de enviar los datos
        event.preventDefault();

        // 2. Dispara los eventos a Google Analytics
        gtag("event", "click_to_call", {
          event_category: "Conversion",
          event_label: phoneUrl,
          value: 1,
        });

        gtag("event", "generate_lead", {
          currency: "USD",
          value: 1,
        });

        // 3. Da 250 ms para asegurar la salida del paquete a Google antes de abrir la app del teléfono
        setTimeout(function () {
          window.location.href = phoneUrl;
        }, 250);
      });
    </script>
  </>
)}
