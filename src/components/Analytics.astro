---
import site from "@/config/site";

const gaId = site.analytics.gaId;
---

{gaId && (
  <>
    <!-- Google tag (gtag.js) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", gaId, {
        send_page_view: true,
      });

      // Función de despacho único hacia Google Analytics
      function dispatchCall(phone) {
        if (window.__callLogged) return;
        window.__callLogged = true;
        setTimeout(function () {
          window.__callLogged = false;
        }, 1500);

        gtag("event", "click_to_call", {
          event_category: "Conversion",
          event_label: phone,
          transport_type: "beacon",
          value: 1,
        });

        gtag("event", "generate_lead", {
          currency: "USD",
          transport_type: "beacon",
          value: 1,
        });
      }

      // 1. Detección táctil anticipada para celulares (se ejecuta antes de abrir el marcador)
      var touchEvent = "PointerEvent" in window ? "pointerdown" : "touchstart";
      document.addEventListener(
        touchEvent,
        function (e) {
          var link = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
          if (link) {
            var phone = link.getAttribute("href") || "+12143027757";
            dispatchCall(phone);
          }
        },
        { capture: true, passive: true }
      );

      // 2. Respaldo para clics convencionales en computadoras
      document.addEventListener(
        "click",
        function (e) {
          var link = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
          if (link) {
            var phone = link.getAttribute("href") || "+12143027757";
            dispatchCall(phone);
          }
        },
        true
      );
    </script>
  </>
)}
