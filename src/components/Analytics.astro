---
import site from "@/config/site";

const gaId = site.analytics?.gaId || "G-GKQ9XH44TE";
---

{gaId && (
  <>
    <!-- Google tag (gtag.js) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", gaId, {
        send_page_view: true,
      });

      // Interceptor optimizado con transporte beacon para llamadas móviles
      document.addEventListener("click", function (event) {
        var phoneLink = event.target && event.target.closest ? event.target.closest('a[href^="tel:"]') : null;
        if (!phoneLink) return;

        var phoneUrl = phoneLink.getAttribute("href") || "";

        gtag("event", "click_to_call", {
          event_category: "Conversion",
          event_label: phoneUrl,
          value: 1,
          transport_type: "beacon",
        });

        gtag("event", "generate_lead", {
          currency: "USD",
          value: 1,
          transport_type: "beacon",
        });
      });
    </script>
  </>
)}
