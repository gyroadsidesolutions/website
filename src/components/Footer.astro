---
import Navigation from "@/components/Navigation.astro";
import SocialIcons from "@/components/SocialIcons.astro";
import business from "@/data/business";
import { activeServices } from "@/data/services";
import { t } from "@/i18n/index";
import type { Lang } from "@/i18n/index";

export interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);
const currentYear = new Date().getFullYear();
const servicesPath = lang === "es" ? `/es/servicios/` : `/en/services/`;
const privacyPath  = lang === "es" ? `/es/politica-de-privacidad/` : `/en/privacy-policy/`;
const termsPath    = lang === "es" ? `/es/terminos-de-uso/` : `/en/terms-of-use/`;
const accessPath   = lang === "es" ? `/es/accesibilidad/` : `/en/accessibility/`;
---

<footer class="bg-primary text-white" role="contentinfo">

  <!-- Main footer grid -->
  <div class="container pt-14 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">

      <!-- Brand -->
      <div>
        <a href={`/${lang}/`} aria-label={`${business.name} — Home`} class="inline-block mb-5">
          <img
  src="/images/Code_Generated_Image.webp"
  alt={`${business.name} logo`}
  width="130" height="40"
  class="h-8 md:h-9 w-auto object-contain"
  loading="lazy"
  onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
/>
          <div class="hidden">
            <span class="text-secondary font-black text-xl">GY</span>
            <span class="text-white font-bold text-sm ml-1">ROADSIDE</span>
          </div>
        </a>
        <p class="text-white/75 text-sm leading-relaxed mb-5">
          {lang === "es"
            ? "Asistencia móvil en carretera para camiones comerciales y otros vehículos en el área de Dallas-Fort Worth, Texas."
            : "Mobile roadside assistance for commercial trucks and other vehicles in the Dallas-Fort Worth, Texas area."}
        </p>
        <!-- Service area pill -->
        <div class="inline-flex items-center gap-2 bg-accent/15 border border-accent/30 text-accent text-xs font-bold px-3 py-1.5 rounded-full">
          <span class="w-2 h-2 bg-accent rounded-full" aria-hidden="true"></span>
          {lang === "es" ? "Área: Dallas-Fort Worth, TX" : "Area: Dallas-Fort Worth, TX"}
        </div>

        <!-- Social links -->
        <SocialIcons variant="footer" class="mt-5" />
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-5 opacity-70">
          {lang === "es" ? "Navegación" : "Quick Links"}
        </h3>
        <Navigation lang={lang} currentPath="" variant="footer" />
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-5 opacity-70">
          {lang === "es" ? "Nuestros Servicios" : "Our Services"}
        </h3>
        <ul class="space-y-2 list-none m-0 p-0">
          {activeServices.map((service) => {
            const slug = lang === "es" ? service.slugEs : service.slug;
            const href = lang === "es" ? `/es/servicios/${slug}/` : `/en/services/${slug}/`;
            return (
              <li>
                <a href={href} class="text-white/75 hover:text-accent transition-colors text-sm flex items-center gap-2 group">
                  <svg aria-hidden="true" class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                  </svg>
                  {service.title[lang]}
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-5 opacity-70">
          {lang === "es" ? "Contacto" : "Contact"}
        </h3>
        <ul class="space-y-4 list-none m-0 p-0">
          <li>
            <a href={`tel:${business.phone}`}
               class="flex items-center gap-3 text-white/75 hover:text-accent transition-colors group">
              <div class="w-8 h-8 rounded-lg bg-white/10 group-hover:bg-accent/20 flex items-center justify-center flex-shrink-0 transition-colors">
                <svg aria-hidden="true" class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <p class="text-white text-sm font-bold">{business.phoneDisplay}</p>
                <p class="text-white/60 text-xs">{lang === "es" ? "Llámenos para coordinar el servicio" : "Call us to coordinate service"}</p>
              </div>
            </a>
          </li>
          <li>
            <a href={`mailto:${business.email}`}
               class="flex items-center gap-3 text-white/75 hover:text-accent transition-colors group">
              <div class="w-8 h-8 rounded-lg bg-white/10 group-hover:bg-accent/20 flex items-center justify-center flex-shrink-0 transition-colors">
                <svg aria-hidden="true" class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <p class="text-white/70 text-xs break-all">{business.email}</p>
            </a>
          </li>
        </ul>

        <!-- CTA -->
        <a href={`tel:${business.phone}`}
           class="mt-6 flex items-center justify-center gap-2 w-full bg-accent text-dark font-bold text-sm py-3 rounded-lg hover:bg-accent-light transition-colors">
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {lang === "es" ? "Llamar Ahora" : "Call Now"}
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/50">
      <p>&copy; {currentYear} {business.name}. {lang === "es" ? "Todos los derechos reservados." : "All rights reserved."}</p>
      <nav aria-label={lang === "es" ? "Enlaces legales" : "Legal links"}>
        <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 list-none m-0 p-0" role="list">
          <li>
            <a href={privacyPath} class="hover:text-white transition-colors">
              {lang === "es" ? "Política de Privacidad" : "Privacy Policy"}
            </a>
          </li>
          <li>
            <a href={termsPath} class="hover:text-white transition-colors">
              {lang === "es" ? "Términos de Uso" : "Terms of Use"}
            </a>
          </li>
          <li>
            <a href={accessPath} class="hover:text-white transition-colors">
              {lang === "es" ? "Accesibilidad" : "Accessibility"}
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
