---
import Navigation from "@/components/Navigation.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import business from "@/data/business";
import { t } from "@/i18n/index";
import type { Lang } from "@/i18n/index";

export interface Props {
  lang: Lang;
  currentPath: string;
}
const { lang, currentPath } = Astro.props;
const tr = t(lang);
---

<header class="bg-primary sticky top-0 z-40 shadow-lg" role="banner">

  <!-- Top bar -->
  <div class="bg-primary border-b border-white/10 hidden md:block">
    <div class="container flex items-center justify-between py-2 text-xs text-white/70">
      <span class="font-medium tracking-wide">
        {lang === "es"
          ? "Asistencia móvil en carretera para camiones comerciales y otros vehículos en el área de Dallas-Fort Worth, Texas"
          : "Mobile roadside assistance for commercial trucks and other vehicles in the Dallas-Fort Worth, Texas area"}
      </span>
      <div class="flex items-center gap-6">
        <a href={lang === "es" ? "/es/area-de-servicio/" : "/en/service-area/"} class="flex items-center gap-1 hover:text-accent transition-colors">
          <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          {lang === "es" ? "Área de Servicio" : "Service Area"}
        </a>
        <a href={`tel:${business.phone}`} class="flex items-center gap-1 hover:text-accent transition-colors font-semibold">
          <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {lang === "es" ? "Llamar:" : "Call Now:"} {business.phoneDisplay}
        </a>
        <LanguageSwitcher lang={lang} currentPath={currentPath} />
      </div>
    </div>
  </div>

  <!-- Main nav row -->
  <div class="container">
    <div class="flex items-center justify-between h-16 md:h-20 gap-4">

      <!-- Logo -->
      <a href={`/${lang}/`} class="flex items-center gap-2 flex-shrink-0" aria-label={`${business.name} — Home`}>
        <img
          src="/images/Code_Generated_Image.webp"
          alt={`${business.name} logo`}
          class="h-12 md:h-16 w-auto object-contain"
          fetchpriority="high"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
        />
        <!-- Fallback text logo if image missing -->
        <div class="hidden items-center gap-1" aria-hidden="true">
          <span class="text-secondary font-black text-2xl">GY</span>
          <div class="leading-none">
            <div class="text-white font-black text-sm tracking-wider">ROADSIDE</div>
            <div class="bg-secondary text-white text-[9px] font-bold px-1 tracking-widest">SOLUTIONS LLC</div>
          </div>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1 flex-1 justify-center"
           role="navigation"
           aria-label={lang === "es" ? "Navegación principal" : "Main navigation"}>
        <Navigation lang={lang} currentPath={currentPath} variant="desktop" />
      </nav>

      <!-- Right side: lang + CTA -->
      <div class="hidden lg:flex items-center gap-4 flex-shrink-0">
        <LanguageSwitcher lang={lang} currentPath={currentPath} />
        <a
          href={`tel:${business.phone}`}
          class="btn bg-accent text-dark hover:bg-accent-light shadow-cta font-bold text-sm py-2.5 px-5"
          aria-label={`${tr.nav.callNow}: ${business.phoneDisplay}`}
        >
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {tr.nav.callNow}
        </a>
      </div>

      <!-- Mobile right -->
      <div class="flex lg:hidden items-center gap-3">
        <LanguageSwitcher lang={lang} currentPath={currentPath} />
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-lg text-white hover:bg-white/10 transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={lang === "es" ? "Abrir menú" : "Open menu"}
        >
          <svg id="icon-open" aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" aria-hidden="true" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-primary border-t border-white/10"
    role="dialog"
    aria-modal="true"
    aria-label={lang === "es" ? "Menú de navegación" : "Navigation menu"}
  >
    <div class="container py-4 space-y-1">
      <Navigation lang={lang} currentPath={currentPath} variant="mobile" />
      <div class="pt-4 border-t border-white/10 space-y-3">
        <a href={`tel:${business.phone}`}
           class="btn bg-accent text-dark hover:bg-accent-light w-full justify-center text-base font-bold">
          <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {business.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  header {
    padding-top: env(safe-area-inset-top);
  }
</style>

<script>
  const btn   = document.getElementById("mobile-menu-btn");
  const menu  = document.getElementById("mobile-menu");
  const iOpen = document.getElementById("icon-open");
  const iClose= document.getElementById("icon-close");

  function open()  { menu?.classList.remove("hidden"); btn?.setAttribute("aria-expanded","true");  iOpen?.classList.add("hidden"); iClose?.classList.remove("hidden"); (menu?.querySelector("a") as HTMLElement)?.focus(); }
  function close() { menu?.classList.add("hidden");    btn?.setAttribute("aria-expanded","false"); iOpen?.classList.remove("hidden"); iClose?.classList.add("hidden"); }

  btn?.addEventListener("click", () => btn.getAttribute("aria-expanded") === "true" ? close() : open());
  document.addEventListener("keydown", e => e.key === "Escape" && close());
  document.addEventListener("click", e => { if (!btn?.contains(e.target as Node) && !menu?.contains(e.target as Node)) close(); });
</script>
