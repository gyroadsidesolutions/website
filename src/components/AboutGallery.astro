<script>
  const root = document.querySelector<HTMLElement>("[data-gallery]");
  if (root) {
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const slideEls = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-dot]"));
    const prevBtn = root.querySelector<HTMLElement>("[data-prev]")!;
    const nextBtn = root.querySelector<HTMLElement>("[data-next]")!;
    const N = slideEls.length;
    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const go = (i: number) => {
      index = (i + N) % N;
      track.style.transform = `translateX(-${index * 100}%)`;
      slideEls.forEach((s, k) => s.classList.toggle("is-active", k === index));
      dots.forEach((d, k) => {
        const active = k === index;
        d.setAttribute("aria-selected", String(active));
        d.classList.toggle("dot-active", active);
      });
    };
    const next = () => go(index + 1);
    const prev = () => go(index - 1);
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const start = () => { stop(); timer = setInterval(next, 3000); };

    nextBtn.addEventListener("click", () => { next(); start(); });
    prevBtn.addEventListener("click", () => { prev(); start(); });
    dots.forEach((d) =>
      d.addEventListener("click", () => { go(Number(d.dataset.dot)); start(); })
    );

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);

    root.setAttribute("tabindex", "0");
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { next(); start(); }
      if (e.key === "ArrowLeft") { prev(); start(); }
    });

    // Soporte para deslizar con el dedo en celular
    let startX: number | null = null;
    track.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; stop(); }, { passive: true });
    track.addEventListener("touchend", (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) { dx < 0 ? next() : prev(); }
      startX = null;
      start();
    });

    go(0);
    start();
  }
</script>
