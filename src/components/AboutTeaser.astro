---
import type { Lang } from "@/i18n/index";
import { sanityClient } from "sanity:client";
import imageUrlBuilder from "@sanity/image-url";

export interface Props { lang: Lang; }
const { lang } = Astro.props;

const builder = imageUrlBuilder(sanityClient);

// Consulta la foto fija institucional del equipo configurada en Sanity Studio
const aboutData = await sanityClient.fetch(
  `*[_type == "aboutSettings"][0]{ image }`
);

const aboutImageUrl = aboutData?.image
  ? builder.image(aboutData.image).width(1000).auto("format").url()
  : "/images/about/about-us.webp";
---

<section class="section bg-light" aria-labelledby="about-teaser-heading">
  <div class="container">
    <div class="about-grid">
      <div class="about-media">
        <img
          src={aboutImageUrl}
          alt={lang === "es"
            ? "Equipo de GY Roadside Solutions asistiendo un camión comercial"
            : "GY Roadside Solutions team assisting a commercial truck"}
          loading="lazy"
          width="800"
          height="600"
        />
        <div class="about-badge" aria-hidden="true">
          <span class="about-badge-strong">GY</span>
          <span>{lang === "es" ? "A su lado" : "By your side"}</span>
        </div>
      </div>

      <div class="about-copy">
        <span class="section-label">
          {lang === "es" ? "Sobre Nosotros" : "About Us"}
        </span>
        <h2 id="about-teaser-heading" class="text-primary">
          {lang === "es"
            ? "Gente real que atiende en la carretera"
            : "Real people who serve you on the road"}
        </h2>
        <p class="text-muted text-base leading-relaxed mt-4">
          {lang === "es"
            ? "GY Roadside Solutions LLC ofrece asistencia móvil para camiones comerciales y otros vehículos en el área de Dallas-Fort Worth, Texas. Nuestro compromiso es brindar un servicio profesional, responsable y cercano, atendiendo las necesidades de cada cliente directamente donde se encuentre su vehículo."
            : "GY Roadside Solutions LLC provides mobile assistance for commercial trucks and other vehicles in the Dallas-Fort Worth, Texas area. Our commitment is to deliver professional, responsible, and personal service, addressing each customer's needs right where their vehicle is located."}
        </p>

        <ul class="about-list" role="list">
          <li>
            <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>
              <span class="about-point-title">{lang === "es" ? "Atención personalizada" : "Personalized Attention"}</span>
              <span class="about-point-desc">{lang === "es" ? "Atención directa y comunicación clara con cada cliente." : "Direct service and clear communication with every customer."}</span>
            </span>
          </li>
          <li>
            <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>
              <span class="about-point-title">{lang === "es" ? "Servicio móvil en carretera" : "Mobile Roadside Service"}</span>
              <span class="about-point-desc">{lang === "es" ? "Nos desplazamos hasta donde se encuentre su vehículo." : "We come to wherever your vehicle is located."}</span>
            </span>
          </li>
          <li>
            <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>
              <span class="about-point-title">{lang === "es" ? "Atención bilingüe (ES / EN)" : "Bilingual Support (ES / EN)"}</span>
              <span class="about-point-desc">{lang === "es" ? "Comunicación en español e inglés para facilitar la atención al cliente." : "Communication in Spanish and English for better customer service."}</span>
            </span>
          </li>
        </ul>

        <a
          href={lang === "es" ? "/es/nosotros/" : "/en/about-us/"}
          class="about-link btn-outline-dark"
        >
          {lang === "es" ? "Conozca a la empresa" : "Learn more about us"}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .about-grid { grid-template-columns: 0.95fr 1.05fr; gap: 4rem; }
  }
  .about-media { position: relative; }
  .about-media img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 1.25rem;
    box-shadow: 0 30px 60px -35px rgba(13, 27, 46, 0.6);
  }
  .about-badge {
    position: absolute;
    bottom: -1rem;
    left: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: #0D1B2E;
    color: #fff;
    padding: 0.7rem 1.1rem;
    border-radius: 0.8rem;
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: 0 16px 30px -16px rgba(13, 27, 46, 0.8);
  }
  .about-badge-strong {
    display: grid; place-items: center;
    width: 2rem; height: 2rem; border-radius: 0.5rem;
    background: linear-gradient(135deg, #F5C518 0%, #FFD740 100%);
    color: #0D1B2E;
    font-weight: 900;
  }
  .about-list {
    list-style: none;
    margin: 1.5rem 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .about-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: #0D1B2E;
  }
  .about-list svg { color: #C8102E; flex-shrink: 0; margin-top: 0.15rem; }
  .about-list li > span:not(:first-child) { flex: 1; min-width: 0; }
  .about-point-title { display: block; font-weight: 800; font-size: 1rem; line-height: 1.3; }
  .about-point-desc { display: block; color: #556374; font-size: 0.9rem; font-weight: 400; line-height: 1.5; margin-top: 0.15rem; }
</style>
